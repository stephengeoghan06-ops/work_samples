/* SQL Example: looking at all potential trades per day using two strategies, then picking the best performing trade per strategy
for each day. To give a best case but realistic idea of how much one can earn per day*/



with morning_move_trades as
(
Select
'Morning_move' as Strategy,
Ticker,
format(Trading_date,'MM/dd/yyyy') as Trading_date,
Opening_Price, 
Low_hit,
Next_high,
(case when Low_hit < 45 then 1000 when Low_hit < 70 then 500 when Low_hit < 120 then 250 when Low_hit < 200 then 200
when Low_hit < 300 then 150 when Low_hit < 500 then 100 else 50 end) * Low_hit as Block_Cost,

case when Low_hit < 45 then 1000 when Low_hit < 70 then 500 when Low_hit < 120 then 250 when Low_hit < 200 then 200
when Low_hit < 300 then 150 when Low_hit < 500 then 100 else 50 end as Block_size,

(Next_high-Low_hit)* (case when Low_hit < 45 then 1000 when Low_hit < 70 then 500 when Low_hit < 120 then 250 when Low_hit < 200 then 200
when Low_hit < 300 then 150 when Low_hit < 500 then 100 else 50 end) as Potential_Profit,
Format(cast(First_low_time as datetime),'HH:mm') as when_Trade_started,
datediff(minute,First_low_time,Next_High_time) as Minutes_to_hold

 
 From 
[dbo].[Daily_morning_move]
)

,

top_trade_per_day as (
select 
row_number() over (partition by Trading_date order by Potential_Profit desc) as row_nm,
Strategy,
Ticker,
Trading_date,
Low_hit,
Next_high,
Block_Cost,
Block_size,
Potential_Profit,
when_Trade_started,
Minutes_to_hold
from morning_move_trades
)

,

morning_moves_lined_up as (
Select 
Strategy,
Ticker,
Trading_date,
Low_hit,
Next_high,
Block_Cost,
Block_size,
Potential_Profit,
when_Trade_started,
Minutes_to_hold
from top_trade_per_day
where row_nm = 1)

/*select * From morning_moves_lined_up*/
,

RSI_profit as (
select 
'RSI_Purchases' as Strategy,
Symbol as Ticker,
calendarday as Trading_date,
RSI_Below_20_AMT as Low_hit,
Next_SPY_High as Next_high,
(case when RSI_Below_20_AMT < 45 then 1000 when RSI_Below_20_AMT < 70 then 500 when RSI_Below_20_AMT < 120 then 250 when RSI_Below_20_AMT < 200 then 200
when RSI_Below_20_AMT < 300 then 150 when RSI_Below_20_AMT < 500 then 100 else 50 end) * RSI_Below_20_AMT as Block_Cost,

case when RSI_Below_20_AMT < 45 then 1000 when RSI_Below_20_AMT < 70 then 500 when RSI_Below_20_AMT < 120 then 250 when RSI_Below_20_AMT < 200 then 200
when RSI_Below_20_AMT < 300 then 150 when RSI_Below_20_AMT < 500 then 100 else 50 end as Block_size,


(Next_SPY_High-RSI_Below_20_AMT)* (case when RSI_Below_20_AMT < 45 then 1000 when RSI_Below_20_AMT < 70 then 500 when RSI_Below_20_AMT < 120 then 250 when RSI_Below_20_AMT < 200 then 200
when RSI_Below_20_AMT < 300 then 150 when RSI_Below_20_AMT < 500 then 100 else 50 end) as Potential_Profit,
Format(cast(RSI_Below_20_Time as datetime),'HH:mm') as when_Trade_started,
datediff(minute,RSI_Below_20_Time,Time_next_SPY_High) as Minutes_to_hold
 from 
[dbo].[RSI_Lows_Data_Points]
where RSI_Below_20_Time > '10:00')

,

RSI_trades_best_per_day as (select 
Strategy,
Ticker,
Trading_date,
Low_hit,
Next_high,
Block_Cost,
Block_size,
Potential_Profit,
when_Trade_started,
Minutes_to_hold
from (
select 
Strategy,
Ticker,
row_number() over (partition by Trading_date order by Potential_Profit desc) as ordetouse,
Trading_date,
Low_hit,
Next_high,
Block_Cost,
Block_size,
Potential_Profit,
when_Trade_started,
Minutes_to_hold
from RSI_profit) sub
where ordetouse = 1)

 ,

final_data as (
select * from RSI_trades_best_per_day


union all 

select * From morning_moves_lined_up

)

select * from final_data
where Trading_date > GETDATE()-180
order by Trading_date
